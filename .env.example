# ============================================================================
# Montaigne Fix — variables de entorno (plantilla)
# Copia este archivo a `.env.local` (frontend) y rellena los valores.
# NUNCA subas al repo archivos .env con valores reales.
# ============================================================================

# ----------------------------------------------------------------------------
# FRONTEND (Vite) — se incrustan en el JavaScript público.
# Solo valores NO secretos. El navegador no accede a tablas: solo llama a
# Edge Functions.
# ----------------------------------------------------------------------------
# URL del proyecto Supabase, p. ej. https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# Clave pública (anon / publishable). Solo sirve para invocar Edge Functions.
VITE_SUPABASE_ANON_KEY=

# ----------------------------------------------------------------------------
# SERVIDOR (secretos de Supabase Edge Functions)
# Se configuran con: supabase secrets set NOMBRE=valor
# o en el panel: Project Settings → Edge Functions → Secrets.
# NO llevan prefijo VITE_ y NUNCA llegan al navegador.
# SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY los inyecta Supabase automáticamente.
# ----------------------------------------------------------------------------

# Firma de tokens de sesión (cadena aleatoria larga, p. ej. `openssl rand -hex 32`)
MF_SESSION_SECRET=

# Hash del PIN del equipo (se genera con el script de la Fase 3; nunca el PIN en claro)
MF_TEAM_PIN_HASH=
# Hashes de contraseña del gerente, uno por persona
MF_ADMIN_PASSWORD_HASH_FRAN=
MF_ADMIN_PASSWORD_HASH_CURRO=

# Duración de sesión (días)
MF_TEAM_SESSION_DAYS=30
MF_ADMIN_SESSION_DAYS=7

# Origen permitido para CORS (URL de Cloudflare Pages en producción)
MF_ALLOWED_ORIGIN=http://localhost:5173

# Email (SMTP). Principal: soportemundanastudio@mundana.us
# Alternativa: soportestudiozero@gmail.com con smtp.gmail.com:465 y contraseña de aplicación.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Montaigne Fix <soportemundanastudio@mundana.us>"

# Destinatarios de avisos e informes
MF_MANAGER_EMAIL=Francisco.flores@grupomontaigne.com
MF_ANNUAL_REPORT_EMAILS=Francisco.flores@grupomontaigne.com,curromena89@gmail.com
